# Copy this file to .env and fill in real values for your environment.
# .env is gitignored — never commit real secrets. See lib/validation/env.server.ts
# for the full schema and which of these are required vs. optional.

NODE_ENV=development
PORT=3000

# --- Shopify app configuration -------------------------------------------
# From your app's Partners/Dev Dashboard config (populated by
# `shopify app config link` once this project is linked to a real app).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://localhost:3000
# read_products is all Phase 1 (catalog sync, product/image selection)
# needs — see shopify.app.toml's [access_scopes] and
# docs/shopify-integration.md "Access scopes".
SHOPIFY_SCOPES=read_products
# Optional — only needed if you use a custom shop domain in development.
# SHOP_CUSTOM_DOMAIN=

# --- Database (PostgreSQL via Prisma) -------------------------------------
# Port 5433 (not the default 5432) — see docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai_imageshoot?schema=public

# --- Queue (Redis / BullMQ) ------------------------------------------------
# Port 6380 (not the default 6379) — see docker-compose.yml.
REDIS_URL=redis://localhost:6380

# --- Object storage ---------------------------------------------------------
# Real production storage IS wired up — lib/storage/s3-storage-provider.server.ts
# speaks the S3 REST API, which every major provider (AWS S3, Cloudflare
# R2, Backblaze B2, DigitalOcean Spaces, MinIO) implements identically.
# Set OBJECT_STORAGE_PROVIDER=s3 + the bucket/credentials below to use it
# in production; leave unset (the default) to keep using
# LocalFilesystemStorageProvider, correct for local dev/single-host only
# — see docs/production-deployment.md "Object storage".
OBJECT_STORAGE_PROVIDER=
OBJECT_STORAGE_BUCKET=
# Required for a non-AWS vendor (R2/B2/Spaces/MinIO); omit for real AWS
# S3, which resolves its endpoint from OBJECT_STORAGE_REGION instead.
# Cloudflare R2 example: https://<account-id>.r2.cloudflarestorage.com
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# "auto" (the default) is correct for R2 and most non-AWS vendors; set a
# real AWS region (e.g. us-east-1) for real AWS S3.
# OBJECT_STORAGE_REGION=auto
# Directory LocalFilesystemStorageProvider persists processed/generated
# images under. Defaults to .data/storage (gitignored) if unset. Not used
# once OBJECT_STORAGE_PROVIDER=s3 is set.
STORAGE_LOCAL_ROOT=.data/storage
# HMAC secret for signed media URLs (app/routes/app.media.$.tsx) — only
# used by LocalFilesystemStorageProvider (S3-compatible storage signs its
# own URLs). Falls back to a derivation of SHOPIFY_API_SECRET if unset;
# set your own in production.
MEDIA_SIGNING_SECRET=

# --- AI provider -------------------------------------------------------------
# Set AI_PROVIDER=openai + AI_PROVIDER_API_KEY (an OpenAI API key — see
# https://platform.openai.com/api-keys) to use the real, production
# -selected provider — services/ai/openai-image-provider.server.ts,
# speaking OpenAI's actual gpt-image-1 API (both generation and
# image-to-image editing). See docs/ai-pipeline.md "Provider selection"
# for why gpt-image-1 was chosen. AI_PROVIDER_BASE_URL is NOT required
# for AI_PROVIDER=openai (it defaults to https://api.openai.com) — only
# set it to point at a proxy in front of OpenAI's API.
#
# Setting AI_PROVIDER to anything OTHER than "openai" (with
# AI_PROVIDER_BASE_URL also set) instead selects the generic,
# vendor-agnostic "OpenAI-Images-API-compatible" JSON contract
# (services/ai/production-image-generation-provider.server.ts) — for a
# self-hosted or differently-branded endpoint that speaks that shape.
#
# Leave AI_PROVIDER unset to keep every generation running through the
# honest "not configured" path. Never put a real API key here or in
# .env.example.
AI_PROVIDER=
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
# Model identifier(s) forwarded to the provider. AI_PROVIDER_MODEL is the
# fallback used for both request kinds when the more specific vars below
# are unset. Defaults to "gpt-image-1" for AI_PROVIDER=openai when none
# of these three are set.
AI_PROVIDER_MODEL=
# Model for a fresh text-to-image request — falls back to AI_PROVIDER_MODEL.
AI_IMAGE_GENERATION_MODEL=
# Model for an image-editing request (Creative Studio's conversational
# edits: image-to-image, targeted edits, variations) — falls back to
# AI_PROVIDER_MODEL. Many vendors (including OpenAI) run editing on a
# different model than fresh generation.
AI_IMAGE_EDIT_MODEL=
# Per-request timeout (ms) for the production provider's outbound calls.
# Optional — defaults to 90s for AI_PROVIDER=openai, 60s otherwise.
# AI_PROVIDER_TIMEOUT_MS=90000

# --- Image processing provider (Phase 4) -------------------------------------
# Background removal only — enhance/resize run locally (see
# docs/image-processing.md "Provider selection"). Never put a real API key
# here or in .env.example.
IMAGE_PROCESSING_PROVIDER=
REMOVE_BG_API_KEY=

# --- Credit entitlement override (development/test only) -------------------
# A real per-shop plan/subscription system exists (services/billing/plans.ts,
# ShopSubscription, the Shopify Billing API — see docs/billing.md) — do
# NOT set this in a real production deployment, which should rely on
# each shop's actual purchased plan instead. When set, this OVERRIDES the
# resolved plan's monthly credit allowance for every shop, useful only
# for local development/testing a specific limit without seeding a
# ShopSubscription row. See services/usage/entitlement.server.ts's
# `getPlan` and docs/usage.md "Entitlement".
# CREATIVE_STUDIO_MONTHLY_CREDITS=200
