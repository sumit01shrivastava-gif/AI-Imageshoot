# Copy this file to .env and fill in real values for your environment.
# .env is gitignored — never commit real secrets. See lib/validation/env.server.ts
# for the full schema and which of these are required vs. optional.

NODE_ENV=development
PORT=3000

# --- Shopify app configuration -------------------------------------------
# From your app's Partners/Dev Dashboard config (populated by
# `shopify app config link` once this project is linked to a real app).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://localhost:3000
# read_products is all Phase 1 (catalog sync, product/image selection)
# needs — see shopify.app.toml's [access_scopes] and
# docs/shopify-integration.md "Access scopes".
SHOPIFY_SCOPES=read_products
# Optional — only needed if you use a custom shop domain in development.
# SHOP_CUSTOM_DOMAIN=

# --- Database (PostgreSQL via Prisma) -------------------------------------
# Port 5433 (not the default 5432) — see docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai_imageshoot?schema=public

# --- Queue (Redis / BullMQ) ------------------------------------------------
# Port 6380 (not the default 6379) — see docker-compose.yml.
REDIS_URL=redis://localhost:6380

# --- Object storage ---------------------------------------------------------
# Real cloud vendor not yet selected (see lib/storage — Phase 4 persists via
# LocalFilesystemStorageProvider instead, configured below).
# One of: s3 | r2 | gcs | ... (decided in a later phase).
OBJECT_STORAGE_PROVIDER=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# Directory LocalFilesystemStorageProvider persists processed/generated
# images under. Defaults to .data/storage (gitignored) if unset.
STORAGE_LOCAL_ROOT=.data/storage
# HMAC secret for signed media URLs (app/routes/app.media.$.tsx). Falls back
# to a derivation of SHOPIFY_API_SECRET if unset — set your own in production.
MEDIA_SIGNING_SECRET=

# --- AI provider -------------------------------------------------------------
# Set AI_PROVIDER_BASE_URL + AI_PROVIDER_API_KEY to point this app at any
# vendor/self-hosted endpoint speaking the documented images-API-compatible
# JSON contract (see docs/ai-pipeline.md) to get real image generation +
# editing — services/ai/production-image-generation-provider.server.ts.
# Leave both unset to keep every generation running through the honest
# "not configured" path. Never put a real API key here or in .env.example.
AI_PROVIDER=
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
# Model identifier(s) forwarded to the provider. AI_PROVIDER_MODEL is the
# fallback used for both request kinds when the more specific vars below
# are unset.
AI_PROVIDER_MODEL=
# Model for a fresh text-to-image request — falls back to AI_PROVIDER_MODEL.
AI_IMAGE_GENERATION_MODEL=
# Model for an image-editing request (Creative Studio's conversational
# edits: image-to-image, targeted edits, variations) — falls back to
# AI_PROVIDER_MODEL. Many vendors run editing on a different model than
# fresh generation.
AI_IMAGE_EDIT_MODEL=
# Per-request timeout (ms) for the production provider's outbound calls.
# Optional — defaults to that file's own DEFAULT_REQUEST_TIMEOUT_MS.
# AI_PROVIDER_TIMEOUT_MS=60000

# --- Image processing provider (Phase 4) -------------------------------------
# Background removal only — enhance/resize run locally (see
# docs/image-processing.md "Provider selection"). Never put a real API key
# here or in .env.example.
IMAGE_PROCESSING_PROVIDER=
REMOVE_BG_API_KEY=

# --- Creative Studio credit entitlement (development default) ---------------
# No subscription/billing plan exists yet — every shop gets this one flat,
# clearly-labeled monthly credit allowance instead. See
# services/usage/entitlement.server.ts and docs/creative-studio.md "Credit
# lifecycle". Optional — defaults to 200 if unset.
# CREATIVE_STUDIO_MONTHLY_CREDITS=200
