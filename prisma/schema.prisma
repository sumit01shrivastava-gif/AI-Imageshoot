// AI ImageShoot — Prisma schema
//
// Phase 0 added the Shopify session table required by
// @shopify/shopify-app-session-storage-prisma.
//
// Phase 1 added the minimum catalog-sync + source-image-selection models:
// ShopifyProduct, ShopifyProductMedia, ShopSyncState, ImageSelection,
// ImageSelectionItem. See docs/database.md for the reasoning behind each.
//
// Phase 2 adds the Product Intelligence model: ProductIntelligence. See
// docs/product-intelligence.md.
//
// Phase 3 adds the image-generation foundation: GenerationJob,
// GenerationResult. See docs/generation.md.
//
// Remaining domain models (GenerationPreset, BrandStyle, ModelPreset,
// MediaAsset, MediaVersion, UsageRecord, CreditBalance, CreditTransaction,
// Publication, AuditLog, ...) are intentionally NOT defined yet — they
// belong to later phases. See docs/database.md and docs/roadmap.md.
//
// learn more about Prisma schema: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Required, as-is, by @shopify/shopify-app-session-storage-prisma.
// Do not rename fields or change types — the session storage adapter
// depends on this exact shape.
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  // Every session belongs to exactly one shop (tenant). Indexed because
  // shop-scoped lookups are the foundation of tenant isolation — see
  // lib/auth/tenant.server.ts and docs/architecture.md.
  @@index([shop])
}

// ---------------------------------------------------------------------------
// Phase 1 — Shopify catalog sync + source-image selection
// ---------------------------------------------------------------------------

// Mirrors Shopify's ProductStatus enum (Admin GraphQL). Kept as our own enum
// (rather than a raw string) so Prisma/TypeScript catch a mismatch if
// Shopify's set of values is used incorrectly elsewhere in the app.
enum ProductStatus {
  ACTIVE
  ARCHIVED
  DRAFT
}

// Bookkeeping for the catalog synchronization job, one row per shop. Not a
// mirror of any Shopify object — purely local sync state (see
// services/products/sync.server.ts and docs/database.md "Sync strategy").
enum SyncStatus {
  IDLE
  SYNCING
  FAILED
}

// Local, synchronized copy of the subset of a Shopify product our UI/AI
// pipeline needs. Shopify remains the source of truth — this row exists for
// fast, paginated, searchable product listing without hitting the Admin API
// on every request (see docs/database.md "Why Shopify's catalog isn't fully
// mirrored" and docs/shopify-integration.md).
model ShopifyProduct {
  id String @id @default(cuid())

  // Tenant. Every query against this model must be scoped by shop — see
  // lib/auth/tenant.server.ts and CLAUDE.md "Security requirements".
  shop String

  // Shopify's GraphQL global ID, e.g. "gid://shopify/Product/123456789".
  shopifyProductId String

  title       String
  handle      String
  description String        @default("")
  productType String        @default("")
  // Shopify's product taxonomy category (Product.category.fullName), where
  // Shopify has one assigned. Free text — not a foreign key into a local
  // taxonomy table, since we don't mirror Shopify's taxonomy.
  category    String?
  vendor      String        @default("")
  tags        String[]      @default([])
  status      ProductStatus

  // Shopify's own timestamps for this product (used to drive incremental
  // sync — see services/products/sync.server.ts).
  shopifyCreatedAt DateTime
  shopifyUpdatedAt DateTime

  // When our local row was last synchronized from Shopify.
  syncedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media          ShopifyProductMedia[]
  selectionItems ImageSelectionItem[]
  intelligence   ProductIntelligence?
  generationJobs GenerationJob[]

  // One local row per Shopify product per shop; safe-upsert target for sync.
  @@unique([shop, shopifyProductId])
  // Product list filters/sorts by these — see services/products/search.server.ts.
  @@index([shop, status])
  @@index([shop, updatedAt])
  @@index([shop, title])
}

// One row per synchronized product image. Phase 1 only syncs image media
// (Shopify's MediaImage) — video/3D/external-video media types aren't
// meaningful "source images" for the future AI pipeline, so they're not
// persisted here (see docs/database.md).
//
// `originalUrl`/`previewUrl` are Shopify-hosted CDN URLs, stored as
// references only. CLAUDE.md "Storage rules": Shopify-hosted image URLs are
// never treated as permanent application-owned assets, and the original
// image is never modified or overwritten by this app.
model ShopifyProductMedia {
  id String @id @default(cuid())

  shop String

  productId String
  product   ShopifyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Denormalized alongside productId so a webhook-driven upsert (which only
  // has Shopify's GraphQL IDs, not our local cuids) can target this table
  // directly.
  shopifyProductId String
  shopifyMediaId   String

  // Shopify's mediaContentType (currently always "IMAGE" — see above).
  // Left as a string rather than an enum with one member.
  mediaType String

  // Reference-only Shopify CDN URLs — never our own storage. See model doc
  // comment above.
  originalUrl String
  previewUrl  String?

  width    Int?
  height   Int?
  altText  String?
  // Shopify's media ordering for this product (0-based).
  position Int     @default(0)

  syncedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  selectionItems ImageSelectionItem[]

  @@unique([shop, shopifyMediaId])
  @@index([shop, productId, position])
}

// Bookkeeping for the catalog synchronization job, one row per shop.
model ShopSyncState {
  shop String @id

  status       SyncStatus @default(IDLE)
  lastSyncedAt DateTime?
  // Merchant-safe summary of the last failure, if any (see CLAUDE.md "Safe
  // error handling" — no stack traces/internal detail here).
  lastError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A merchant's chosen set of source images, captured once (on "Continue")
// so the next phase has a concrete, server-validated request to consume
// instead of only ever-transient browser state — see
// docs/database.md#selection-model and CLAUDE.md's Phase 1 instructions
// ("do not create the final GenerationJob model yet").
//
// Deliberately minimal: no "operation" or "generation configuration" field
// exists yet, because no operation has been chosen at this point in the
// flow — those belong to the GenerationJob model a future phase will add.
model ImageSelection {
  id   String @id @default(cuid())
  shop String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ImageSelectionItem[]

  @@index([shop])
}

// One selected source image within an ImageSelection. Cascades if the
// underlying product/media is later removed by sync (e.g. the merchant
// deleted the product in Shopify before this selection was consumed).
model ImageSelectionItem {
  id String @id @default(cuid())

  selectionId String
  selection   ImageSelection @relation(fields: [selectionId], references: [id], onDelete: Cascade)

  shop String

  productId String
  product   ShopifyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  productMediaId String
  productMedia   ShopifyProductMedia @relation(fields: [productMediaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([selectionId, productMediaId])
  @@index([shop])
}

// ---------------------------------------------------------------------------
// Phase 2 — Product Intelligence
// ---------------------------------------------------------------------------

// Lifecycle of one product's intelligence profile. Deliberately does NOT
// include a persisted "STALE" state — see docs/product-intelligence.md
// "Staleness": staleness is derived at read time (comparing
// `sourceShopifyUpdatedAt` below against the product's current
// `shopifyUpdatedAt`), not a state a background process needs to write,
// which would require new webhook plumbing this phase doesn't need.
enum IntelligenceStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

// One row per product: the CURRENT structured Product Intelligence profile
// (category, material, color, style, identity anchors, generation
// recommendations, ...). Shopify + its original product images remain the
// source of truth this is derived from — see docs/product-intelligence.md
// "Identity preservation".
//
// One profile per product (not a history table): `analysisVersion` tracks
// which analysis iteration produced the current row, and re-analysis
// overwrites it in place. A full audit history is deliberately deferred —
// not needed to prove the intelligence layer works (see CLAUDE.md
// "Incremental development").
model ProductIntelligence {
  id String @id @default(cuid())

  // Tenant. Every query against this model must be scoped by shop — see
  // lib/auth/tenant.server.ts and CLAUDE.md "Security requirements".
  shop String

  productId String         @unique
  product   ShopifyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  status IntelligenceStatus @default(PENDING)
  // Merchant-safe summary of the last failure, if any (see CLAUDE.md "Safe
  // error handling" — no stack traces/internal detail here).
  errorMessage String?

  // --- Structured profile — all empty/null until status = READY.
  // See docs/product-intelligence.md "Schema" and
  // services/intelligence/schema.ts (the Zod schema this mirrors; a
  // provider's output is validated against that schema before ever
  // reaching these columns — see CLAUDE.md "Reject malformed provider
  // output").
  category    String?
  subcategory String?
  productType String?

  material        String?
  primaryColor    String?
  secondaryColors String[] @default([])

  pattern String?
  texture String?
  style   String?

  useCases          String[] @default([])
  targetAudience    String?
  genderSuitability String?
  seasonality       String[] @default([])
  pricePositioning  String?

  // Free-form, provider-specific detail that doesn't warrant its own
  // columns (see CLAUDE.md "Do not create unnecessary normalization
  // tables for simple AI attributes") — each validated as a JSON object
  // shape by services/intelligence/schema.ts, just not column-by-column.
  visualCharacteristics    Json?
  productDimensions        Json?
  packagingCharacteristics Json?
  hardwareComponents       String[] @default([])

  // --- Model (human-model imagery) suitability — see
  // docs/product-intelligence.md "Model suitability". No image is
  // generated from this in Phase 2; it's structured intelligence only.
  modelSuitable              Boolean?
  recommendedModelAttributes Json?
  recommendedPoseTypes       String[] @default([])

  // --- Generation recommendations — category-aware, see
  // services/intelligence/category-recommendations.ts.
  recommendedEnvironments      String[] @default([])
  recommendedProps             String[] @default([])
  recommendedPhotographyStyles String[] @default([])
  recommendedAssetTypes        String[] @default([])

  // Structured, identity-critical attributes a future generation stage
  // must preserve (never invent/alter) — see docs/product-intelligence.md
  // "Identity preservation". Kept as JSON (not columns) since its shape
  // is validated by services/intelligence/schema.ts's IdentityAnchorsSchema
  // and consumed as a whole object, not queried field-by-field.
  identityAnchors Json?

  // Per-source-image observations (one entry per analyzed
  // ShopifyProductMedia) — see docs/product-intelligence.md "Image
  // analysis". JSON rather than a related table: consumed as part of the
  // whole profile, never queried independently (see CLAUDE.md "Do not
  // create unnecessary normalization tables for simple AI attributes").
  imageAnalyses Json?

  // Which analysis iteration produced the current row — 0 until the first
  // *successful* completion (see db/repositories/product-intelligence.
  // repository.ts's `saveResult`, the only place this is bumped; PENDING/
  // PROCESSING bookkeeping never touches it, deliberately, so it always
  // reflects "how many completed analyses has this product had", not "how
  // many times has some row-touching upsert run"). Confidence is the
  // provider's own self-reported score.
  analysisVersion Int     @default(0)
  confidence      Float?
  providerName    String?
  // Raw, unvalidated provider output — kept for debugging only. Never
  // returned to the client; see CLAUDE.md "Safe error handling" and
  // app/routes/app.products.$id.tsx's loader.
  rawAnalysis     Json?

  // Staleness watermark: the product's `shopifyUpdatedAt` at analysis
  // time. Staleness is `product.shopifyUpdatedAt > sourceShopifyUpdatedAt`
  // — see docs/product-intelligence.md "Staleness" for why this (Shopify's
  // own timestamp), not our local sync bookkeeping (which changes on every
  // resync regardless of whether anything relevant actually changed).
  sourceShopifyUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, status])
}

// ---------------------------------------------------------------------------
// Phase 3 — Image generation foundation
// ---------------------------------------------------------------------------

// The generation taxonomy — see docs/generation.md "Generation types".
// Establishing room for all nine now (per the Phase 3 instructions) does
// NOT mean all nine are implemented: this phase only ever actually drives
// PRODUCT_CLEANUP end to end (services/generation/deterministic-test-
// provider.server.ts, the "Generate Test Image" UI). The rest are valid,
// schema-accepted values with no dedicated plan-building logic yet.
enum GenerationType {
  PRODUCT_CLEANUP
  BACKGROUND_REMOVAL
  BACKGROUND_REPLACEMENT
  LIFESTYLE
  MODEL_SHOOT
  BANNER
  CATEGORY_BANNER
  CTA
  CAMPAIGN
}

// PENDING: row created, not yet enqueued. QUEUED: enqueued onto BullMQ,
// waiting for a worker. PROCESSING: a worker is actively calling the
// provider (including during an automatic BullMQ retry backoff — there is
// deliberately no separate "RETRYING" status; `retryCount` below is where
// that's visible). SUCCEEDED/FAILED/CANCELLED are terminal. CANCELLED has
// no producer yet this phase (no cancel action exists) — included now so
// the status column's domain is complete from the start rather than
// needing a migration later. See docs/generation.md "Lifecycle".
enum GenerationStatus {
  PENDING
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

// One row per generation REQUEST — NOT one row per product. Unlike
// ProductIntelligence (one current profile per product, overwritten on
// re-analysis), a product accumulates GenerationJob history: Generation
// #1, #2, #3, ... never overwritten — see docs/generation.md "Generation
// history". "GENERATION REQUEST" and "GENERATION JOB" (the pipeline's own
// terminology) are deliberately the same row here, not two tables: one
// merchant action (Generate / Regenerate) creates exactly one job and
// nothing separates "the request" from "the job" in this system's
// lifecycle — a dedicated GenerationRequest table would just duplicate
// this row 1:1 (see CLAUDE.md "Do not create unnecessary normalization
// tables for simple AI attributes", applied here to the job/request
// distinction rather than an AI attribute, but the same reasoning holds).
model GenerationJob {
  id String @id @default(cuid())

  // Tenant. Every query against this model must be scoped by shop — see
  // lib/auth/tenant.server.ts and CLAUDE.md "Security requirements".
  shop String

  productId String
  product   ShopifyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  type   GenerationType
  status GenerationStatus @default(PENDING)

  // Our internal ShopifyProductMedia ids this generation was requested
  // from — one or many source images (see docs/generation.md "Generation
  // data model").
  sourceMediaIds String[] @default([])

  // The full structured request — see services/generation/schema.ts's
  // GenerationPlanSchema and docs/generation.md "Generation plan".
  // Snapshotted at request time (not re-derived when the job actually
  // runs) so generation history stays accurate even if the product or its
  // Product Intelligence profile changes later — see docs/generation.md
  // "Generation history".
  plan Json

  // Denormalized off `plan.identityAnchors` for direct readability/
  // querying — the product-fact constraints this generation must never
  // violate. See docs/generation.md "Identity preservation".
  identityAnchors Json?

  // Merchant-safe summary of the last failure, if any (see CLAUDE.md "Safe
  // error handling" — no stack traces/internal detail here).
  errorMessage String?
  // How many attempts BullMQ has made at this job — see
  // services/generation/job.server.ts. Distinct from a merchant clicking
  // "Regenerate" (which creates a brand-new row, not a retry of this one).
  retryCount Int @default(0)

  providerName  String?
  providerJobId String?

  startedAt   DateTime?
  completedAt DateTime?
  // Wall-clock duration of the last processing attempt, in milliseconds —
  // usage-accounting foundation only; no billing is computed from this.
  // See docs/generation.md "Usage tracking foundation".
  durationMs Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results GenerationResult[]

  @@index([shop, productId])
  @@index([shop, status])
  @@index([shop, createdAt])
}

// One row per output image a GenerationJob produced — a single job may
// produce multiple results (see docs/generation.md "Generation result
// model"). Never stores image binaries: `storageKey`/`url` are references
// into the existing StorageProvider abstraction (lib/storage/types.ts),
// exactly like ShopifyProductMedia's originalUrl/previewUrl reference
// Shopify's CDN rather than embedding bytes — see CLAUDE.md "Storage
// rules".
model GenerationResult {
  id String @id @default(cuid())

  // Tenant — denormalized alongside generationJobId (rather than requiring
  // a join through GenerationJob for every shop-scoped query), matching
  // the same pattern ShopifyProductMedia/ImageSelectionItem already use.
  shop String

  generationJobId String
  generationJob   GenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)

  // Reference into StorageProvider — never a raw binary.
  storageKey String
  // A fetchable reference for this object at the time it was stored (e.g.
  // a signed URL) — a reference string, like ShopifyProductMedia's URLs,
  // never image bytes.
  url        String?

  width  Int?
  height Int?
  format String?

  providerName     String?
  providerResultId String?
  // Free-form provider-reported detail (seed, model name, per-output
  // timing, ...) — see docs/generation.md "Usage tracking foundation".
  metadata Json?

  createdAt DateTime @default(now())

  @@index([shop, generationJobId])
}
