// AI ImageShoot — Prisma schema
//
// Phase 0 added the Shopify session table required by
// @shopify/shopify-app-session-storage-prisma.
//
// Phase 1 added the minimum catalog-sync + source-image-selection models:
// ShopifyProduct, ShopifyProductMedia, ShopSyncState, ImageSelection,
// ImageSelectionItem. See docs/database.md for the reasoning behind each.
//
// Phase 2 adds the Product Intelligence model: ProductIntelligence. See
// docs/product-intelligence.md.
//
// Phase 3 adds the image-generation foundation: GenerationJob,
// GenerationResult. See docs/generation.md.
//
// Phase 4 adds production image processing (the Basic plan foundation):
// ProcessingJob, ProcessingResult, ProcessingBatch. See
// docs/image-processing.md — including why this is a dedicated model
// family rather than reusing GenerationJob/GenerationResult.
//
// Phase 5 adds AI lifestyle imagery (the Pro plan foundation) as targeted
// extensions of Phase 3's existing GenerationJob/GenerationResult rather
// than a new model family — unlike Phase 4, lifestyle generation is the
// same *kind* of request PRODUCT_CLEANUP already is (a creative
// GenerationPlan → GenerationJob → GenerationResult), so it doesn't
// justify a parallel table set. Adds: GenerationJob.batchId +
// GenerationBatch (mirrors ProcessingBatch — Prisma has no polymorphic
// relation, so batching still needs its own model, just not its own job/
// result pair), GenerationResult.reviewStatus/reviewedAt (reuses the
// existing ReviewStatus enum), and BrandStylePreset (shop-saved custom
// presets only — built-in presets are code constants, see
// services/generation/brand-style-presets.ts). See
// docs/lifestyle-generation.md.
//
// Remaining domain models (GenerationPreset, BrandStyle, ModelPreset,
// MediaAsset, MediaVersion, UsageRecord, CreditBalance, CreditTransaction,
// Publication, AuditLog, ...) are intentionally NOT defined yet — they
// belong to later phases. See docs/database.md and docs/roadmap.md.
//
// learn more about Prisma schema: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Required, as-is, by @shopify/shopify-app-session-storage-prisma.
// Do not rename fields or change types — the session storage adapter
// depends on this exact shape.
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  // Every session belongs to exactly one shop (tenant). Indexed because
  // shop-scoped lookups are the foundation of tenant isolation — see
  // lib/auth/tenant.server.ts and docs/architecture.md.
  @@index([shop])
}

// ---------------------------------------------------------------------------
// Phase 1 — Shopify catalog sync + source-image selection
// ---------------------------------------------------------------------------

// Mirrors Shopify's ProductStatus enum (Admin GraphQL). Kept as our own enum
// (rather than a raw string) so Prisma/TypeScript catch a mismatch if
// Shopify's set of values is used incorrectly elsewhere in the app.
enum ProductStatus {
  ACTIVE
  ARCHIVED
  DRAFT
}

// Bookkeeping for the catalog synchronization job, one row per shop. Not a
// mirror of any Shopify object — purely local sync state (see
// services/products/sync.server.ts and docs/database.md "Sync strategy").
enum SyncStatus {
  IDLE
  SYNCING
  FAILED
}

// Local, synchronized copy of the subset of a Shopify product our UI/AI
// pipeline needs. Shopify remains the source of truth — this row exists for
// fast, paginated, searchable product listing without hitting the Admin API
// on every request (see docs/database.md "Why Shopify's catalog isn't fully
// mirrored" and docs/shopify-integration.md).
model ShopifyProduct {
  id String @id @default(cuid())

  // Tenant. Every query against this model must be scoped by shop — see
  // lib/auth/tenant.server.ts and CLAUDE.md "Security requirements".
  shop String

  // Shopify's GraphQL global ID, e.g. "gid://shopify/Product/123456789".
  shopifyProductId String

  title       String
  handle      String
  description String        @default("")
  productType String        @default("")
  // Shopify's product taxonomy category (Product.category.fullName), where
  // Shopify has one assigned. Free text — not a foreign key into a local
  // taxonomy table, since we don't mirror Shopify's taxonomy.
  category    String?
  vendor      String        @default("")
  tags        String[]      @default([])
  status      ProductStatus

  // Shopify's own timestamps for this product (used to drive incremental
  // sync — see services/products/sync.server.ts).
  shopifyCreatedAt DateTime
  shopifyUpdatedAt DateTime

  // When our local row was last synchronized from Shopify.
  syncedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media            ShopifyProductMedia[]
  selectionItems   ImageSelectionItem[]
  intelligence     ProductIntelligence?
  generationJobs   GenerationJob[]
  processingJobs   ProcessingJob[]
  storeVisualRefs  StoreVisualJobProduct[]
  publishingJobs   PublishingJob[]
  creativeSessions CreativeSession[]

  // One local row per Shopify product per shop; safe-upsert target for sync.
  @@unique([shop, shopifyProductId])
  // Product list filters/sorts by these — see services/products/search.server.ts.
  @@index([shop, status])
  @@index([shop, updatedAt])
  @@index([shop, title])
}

// One row per synchronized product image. Phase 1 only syncs image media
// (Shopify's MediaImage) — video/3D/external-video media types aren't
// meaningful "source images" for the future AI pipeline, so they're not
// persisted here (see docs/database.md).
//
// `originalUrl`/`previewUrl` are Shopify-hosted CDN URLs, stored as
// references only. CLAUDE.md "Storage rules": Shopify-hosted image URLs are
// never treated as permanent application-owned assets, and the original
// image is never modified or overwritten by this app.
model ShopifyProductMedia {
  id String @id @default(cuid())

  shop String

  productId String
  product   ShopifyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Denormalized alongside productId so a webhook-driven upsert (which only
  // has Shopify's GraphQL IDs, not our local cuids) can target this table
  // directly.
  shopifyProductId String
  shopifyMediaId   String

  // Shopify's mediaContentType (currently always "IMAGE" — see above).
  // Left as a string rather than an enum with one member.
  mediaType String

  // Reference-only Shopify CDN URLs — never our own storage. See model doc
  // comment above.
  originalUrl String
  previewUrl  String?

  width    Int?
  height   Int?
  altText  String?
  // Shopify's media ordering for this product (0-based).
  position Int     @default(0)

  syncedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  selectionItems   ImageSelectionItem[]
  processingJobs   ProcessingJob[]
  creativeSessions CreativeSession[]

  @@unique([shop, shopifyMediaId])
  @@index([shop, productId, position])
}

// Bookkeeping for the catalog synchronization job, one row per shop.
model ShopSyncState {
  shop String @id

  status       SyncStatus @default(IDLE)
  lastSyncedAt DateTime?
  // Merchant-safe summary of the last failure, if any (see CLAUDE.md "Safe
  // error handling" — no stack traces/internal detail here).
  lastError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A merchant's chosen set of source images, captured once (on "Continue")
// so the next phase has a concrete, server-validated request to consume
// instead of only ever-transient browser state — see
// docs/database.md#selection-model and CLAUDE.md's Phase 1 instructions
// ("do not create the final GenerationJob model yet").
//
// Deliberately minimal: no "operation" or "generation configuration" field
// exists yet, because no operation has been chosen at this point in the
// flow — those belong to the GenerationJob model a future phase will add.
model ImageSelection {
  id   String @id @default(cuid())
  shop String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ImageSelectionItem[]

  @@index([shop])
}

// One selected source image within an ImageSelection. Cascades if the
// underlying product/media is later removed by sync (e.g. the merchant
// deleted the product in Shopify before this selection was consumed).
model ImageSelectionItem {
  id String @id @default(cuid())

  selectionId String
  selection   ImageSelection @relation(fields: [selectionId], references: [id], onDelete: Cascade)

  shop String

  productId String
  product   ShopifyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  productMediaId String
  productMedia   ShopifyProductMedia @relation(fields: [productMediaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([selectionId, productMediaId])
  @@index([shop])
}

// ---------------------------------------------------------------------------
// Phase 2 — Product Intelligence
// ---------------------------------------------------------------------------

// Lifecycle of one product's intelligence profile. Deliberately does NOT
// include a persisted "STALE" state — see docs/product-intelligence.md
// "Staleness": staleness is derived at read time (comparing
// `sourceShopifyUpdatedAt` below against the product's current
// `shopifyUpdatedAt`), not a state a background process needs to write,
// which would require new webhook plumbing this phase doesn't need.
enum IntelligenceStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

// One row per product: the CURRENT structured Product Intelligence profile
// (category, material, color, style, identity anchors, generation
// recommendations, ...). Shopify + its original product images remain the
// source of truth this is derived from — see docs/product-intelligence.md
// "Identity preservation".
//
// One profile per product (not a history table): `analysisVersion` tracks
// which analysis iteration produced the current row, and re-analysis
// overwrites it in place. A full audit history is deliberately deferred —
// not needed to prove the intelligence layer works (see CLAUDE.md
// "Incremental development").
model ProductIntelligence {
  id String @id @default(cuid())

  // Tenant. Every query against this model must be scoped by shop — see
  // lib/auth/tenant.server.ts and CLAUDE.md "Security requirements".
  shop String

  productId String         @unique
  product   ShopifyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  status       IntelligenceStatus @default(PENDING)
  // Merchant-safe summary of the last failure, if any (see CLAUDE.md "Safe
  // error handling" — no stack traces/internal detail here).
  errorMessage String?

  // --- Structured profile — all empty/null until status = READY.
  // See docs/product-intelligence.md "Schema" and
  // services/intelligence/schema.ts (the Zod schema this mirrors; a
  // provider's output is validated against that schema before ever
  // reaching these columns — see CLAUDE.md "Reject malformed provider
  // output").
  category    String?
  subcategory String?
  productType String?

  material        String?
  primaryColor    String?
  secondaryColors String[] @default([])

  pattern String?
  texture String?
  style   String?

  useCases          String[] @default([])
  targetAudience    String?
  genderSuitability String?
  seasonality       String[] @default([])
  pricePositioning  String?

  // Free-form, provider-specific detail that doesn't warrant its own
  // columns (see CLAUDE.md "Do not create unnecessary normalization
  // tables for simple AI attributes") — each validated as a JSON object
  // shape by services/intelligence/schema.ts, just not column-by-column.
  visualCharacteristics    Json?
  productDimensions        Json?
  packagingCharacteristics Json?
  hardwareComponents       String[] @default([])

  // --- Model (human-model imagery) suitability — see
  // docs/product-intelligence.md "Model suitability". No image is
  // generated from this in Phase 2; it's structured intelligence only.
  modelSuitable              Boolean?
  recommendedModelAttributes Json?
  recommendedPoseTypes       String[] @default([])

  // --- Generation recommendations — category-aware, see
  // services/intelligence/category-recommendations.ts.
  recommendedEnvironments      String[] @default([])
  recommendedProps             String[] @default([])
  recommendedPhotographyStyles String[] @default([])
  recommendedAssetTypes        String[] @default([])

  // Structured, identity-critical attributes a future generation stage
  // must preserve (never invent/alter) — see docs/product-intelligence.md
  // "Identity preservation". Kept as JSON (not columns) since its shape
  // is validated by services/intelligence/schema.ts's IdentityAnchorsSchema
  // and consumed as a whole object, not queried field-by-field.
  identityAnchors Json?

  // Per-source-image observations (one entry per analyzed
  // ShopifyProductMedia) — see docs/product-intelligence.md "Image
  // analysis". JSON rather than a related table: consumed as part of the
  // whole profile, never queried independently (see CLAUDE.md "Do not
  // create unnecessary normalization tables for simple AI attributes").
  imageAnalyses Json?

  // Which analysis iteration produced the current row — 0 until the first
  // *successful* completion (see db/repositories/product-intelligence.
  // repository.ts's `saveResult`, the only place this is bumped; PENDING/
  // PROCESSING bookkeeping never touches it, deliberately, so it always
  // reflects "how many completed analyses has this product had", not "how
  // many times has some row-touching upsert run"). Confidence is the
  // provider's own self-reported score.
  analysisVersion Int     @default(0)
  confidence      Float?
  providerName    String?
  // Raw, unvalidated provider output — kept for debugging only. Never
  // returned to the client; see CLAUDE.md "Safe error handling" and
  // app/routes/app.products.$id.tsx's loader.
  rawAnalysis     Json?

  // Staleness watermark: the product's `shopifyUpdatedAt` at analysis
  // time. Staleness is `product.shopifyUpdatedAt > sourceShopifyUpdatedAt`
  // — see docs/product-intelligence.md "Staleness" for why this (Shopify's
  // own timestamp), not our local sync bookkeeping (which changes on every
  // resync regardless of whether anything relevant actually changed).
  sourceShopifyUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, status])
}

// ---------------------------------------------------------------------------
// Phase 3 — Image generation foundation
// ---------------------------------------------------------------------------

// The generation taxonomy — see docs/generation.md "Generation types".
// Establishing room for all nine now (per the Phase 3 instructions) does
// NOT mean all nine are implemented: this phase only ever actually drives
// PRODUCT_CLEANUP end to end (services/generation/deterministic-test-
// provider.server.ts, the "Generate Test Image" UI). The rest are valid,
// schema-accepted values with no dedicated plan-building logic yet.
enum GenerationType {
  PRODUCT_CLEANUP
  BACKGROUND_REMOVAL
  BACKGROUND_REPLACEMENT
  LIFESTYLE
  MODEL_SHOOT
  BANNER
  CATEGORY_BANNER
  CTA
  CAMPAIGN
  // Any generation/edit requested through the conversational Creative
  // Studio (services/creative-studio/) — one GenerationType covering
  // every fine-grained conversational intent (EDIT_BACKGROUND,
  // ADD_MODEL, CHANGE_LIGHTING, ...), which lives instead in the plan's
  // own `creativeIntent.intent` field (see
  // services/creative-studio/types.ts's CREATIVE_INTENTS) — mirrors how
  // LIFESTYLE's scene detail lives in `lifestyleScene`, not a proliferation
  // of top-level GenerationType values. See docs/creative-studio.md.
  CREATIVE_STUDIO
}

// PENDING: row created, not yet enqueued. QUEUED: enqueued onto BullMQ,
// waiting for a worker. PROCESSING: a worker is actively calling the
// provider (including during an automatic BullMQ retry backoff — there is
// deliberately no separate "RETRYING" status; `retryCount` below is where
// that's visible). SUCCEEDED/FAILED/CANCELLED are terminal. CANCELLED has
// no producer yet this phase (no cancel action exists) — included now so
// the status column's domain is complete from the start rather than
// needing a migration later. See docs/generation.md "Lifecycle".
enum GenerationStatus {
  PENDING
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

// One row per generation REQUEST — NOT one row per product. Unlike
// ProductIntelligence (one current profile per product, overwritten on
// re-analysis), a product accumulates GenerationJob history: Generation
// #1, #2, #3, ... never overwritten — see docs/generation.md "Generation
// history". "GENERATION REQUEST" and "GENERATION JOB" (the pipeline's own
// terminology) are deliberately the same row here, not two tables: one
// merchant action (Generate / Regenerate) creates exactly one job and
// nothing separates "the request" from "the job" in this system's
// lifecycle — a dedicated GenerationRequest table would just duplicate
// this row 1:1 (see CLAUDE.md "Do not create unnecessary normalization
// tables for simple AI attributes", applied here to the job/request
// distinction rather than an AI attribute, but the same reasoning holds).
model GenerationJob {
  id String @id @default(cuid())

  // Tenant. Every query against this model must be scoped by shop — see
  // lib/auth/tenant.server.ts and CLAUDE.md "Security requirements".
  shop String

  // Optional as of the standalone generation-pipeline foundation (see
  // prisma/schema.prisma's CreativeSession.productId comment for the
  // identical prior change to that model) — null for a standalone (no
  // Shopify product) Creative Studio generation, grounded in the
  // conversation/uploaded reference images instead of a Shopify product +
  // Product Intelligence profile. Present exactly as before for every
  // Shopify-context generation (every generationType other than a
  // standalone CREATIVE_STUDIO request). onDelete stays Cascade: a job's
  // product being deleted still means the job's own product-scoped
  // history no longer makes sense, same as today — this column merely
  // became optional, not less strict when present.
  productId String?
  product   ShopifyProduct? @relation(fields: [productId], references: [id], onDelete: Cascade)

  type   GenerationType
  status GenerationStatus @default(PENDING)

  // Our internal ShopifyProductMedia ids this generation was requested
  // from — one or many source images (see docs/generation.md "Generation
  // data model").
  sourceMediaIds String[] @default([])

  // The full structured request — see services/generation/schema.ts's
  // GenerationPlanSchema and docs/generation.md "Generation plan".
  // Snapshotted at request time (not re-derived when the job actually
  // runs) so generation history stays accurate even if the product or its
  // Product Intelligence profile changes later — see docs/generation.md
  // "Generation history".
  plan Json

  // Denormalized off `plan.identityAnchors` for direct readability/
  // querying — the product-fact constraints this generation must never
  // violate. See docs/generation.md "Identity preservation".
  identityAnchors Json?

  // Merchant-safe summary of the last failure, if any (see CLAUDE.md "Safe
  // error handling" — no stack traces/internal detail here).
  errorMessage String?
  // How many attempts BullMQ has made at this job — see
  // services/generation/job.server.ts. Distinct from a merchant clicking
  // "Regenerate" (which creates a brand-new row, not a retry of this one).
  retryCount   Int     @default(0)

  providerName  String?
  providerJobId String?

  startedAt   DateTime?
  completedAt DateTime?
  // Wall-clock duration of the last processing attempt, in milliseconds —
  // usage-accounting foundation only; no billing is computed from this.
  // See docs/generation.md "Usage tracking foundation".
  durationMs  Int?

  // Which batch this job belongs to, if it was created as part of one —
  // see GenerationBatch below (Phase 5). Null for a single-product
  // request from the product detail page. Mirrors
  // ProcessingJob.batchId/ProcessingBatch exactly.
  batchId String?
  batch   GenerationBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  // Which Creative Studio conversation this job belongs to, if any — null
  // for every non-conversational generationType. SetNull (not Cascade):
  // deleting a CreativeSession must never delete the generated images it
  // produced (they may already be approved/published) — mirrors batchId's
  // exact reasoning. See services/creative-studio/, docs/creative-studio.md.
  creativeSessionId String?
  creativeSession   CreativeSession? @relation(fields: [creativeSessionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results GenerationResult[]

  @@index([shop, productId])
  @@index([shop, status])
  @@index([shop, createdAt])
  @@index([batchId])
  @@index([creativeSessionId])
}

// One row per output image a GenerationJob produced — a single job may
// produce multiple results (see docs/generation.md "Generation result
// model"). Never stores image binaries: `storageKey`/`url` are references
// into the existing StorageProvider abstraction (lib/storage/types.ts),
// exactly like ShopifyProductMedia's originalUrl/previewUrl reference
// Shopify's CDN rather than embedding bytes — see CLAUDE.md "Storage
// rules".
model GenerationResult {
  id String @id @default(cuid())

  // Tenant — denormalized alongside generationJobId (rather than requiring
  // a join through GenerationJob for every shop-scoped query), matching
  // the same pattern ShopifyProductMedia/ImageSelectionItem already use.
  shop String

  generationJobId String
  generationJob   GenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)

  // Reference into StorageProvider — never a raw binary.
  storageKey String
  // A fetchable reference for this object at the time it was stored (e.g.
  // a signed URL) — a reference string, like ShopifyProductMedia's URLs,
  // never image bytes.
  url        String?

  width  Int?
  height Int?
  format String?

  providerName     String?
  providerResultId String?
  // Free-form provider-reported detail (seed, model name, per-output
  // timing, ...) — see docs/generation.md "Usage tracking foundation".
  // Phase 5 also records identity-validation results here (see
  // docs/lifestyle-generation.md "Identity validation") — a structured,
  // honest "not yet validated" result, not a new column, since it's
  // debugging/traceability detail, not something queried directly.
  metadata         Json?

  // The merchant's review decision for this result — see
  // docs/lifestyle-generation.md "Review lifecycle". Reuses the existing
  // ReviewStatus enum (Phase 4) rather than a new one. Approving/
  // rejecting never deletes/overwrites the result; "Regenerate" always
  // creates a new GenerationJob/GenerationResult.
  reviewStatus ReviewStatus @default(PENDING)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([shop, generationJobId])
}

// Groups the independent GenerationJobs created by one "select products →
// choose lifestyle configuration → start generation" batch action — see
// docs/lifestyle-generation.md "Batch generation". Field-for-field mirror
// of ProcessingBatch (Phase 4); a separate model rather than reusing it
// because ProcessingBatch.operation/jobs are typed to Processing's own
// enum/model and Prisma has no polymorphic relation — see
// docs/lifestyle-generation.md for the full reasoning. Progress (total/
// queued/processing/succeeded/failed) is likewise computed at read time
// via a groupBy over GenerationJob.status scoped to this batch, never a
// persisted counter.
model GenerationBatch {
  id String @id @default(cuid())

  shop String

  generationType GenerationType

  // The ImageSelection this batch was started from, if any — traceability
  // only; the batch's own jobs are the source of truth once created.
  sourceSelectionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs GenerationJob[]

  @@index([shop, createdAt])
}

// A merchant-saved, reusable, named lifestyle generation configuration —
// see docs/lifestyle-generation.md "Brand style presets". Only CUSTOM
// presets are rows here: the built-in catalog (Minimal Studio, Luxury
// Editorial, ...) is a code constant
// (services/generation/brand-style-presets.ts), not seeded data — every
// shop gets it for free, with zero migration cost, and it's trivially
// versionable in code. `attributes` bundles both brand-style attributes
// (mood, photography style, color direction) and scene defaults
// (environment, surface, props, composition, camera) into one reusable
// named thing, validated by
// services/generation/schema.ts's BrandStylePresetAttributesSchema — the
// instructions' own preset examples mix both kinds of attribute into one
// preset, so this is deliberately one model, not two.
model BrandStylePreset {
  id String @id @default(cuid())

  // Tenant. Every query against this model must be scoped by shop — see
  // lib/auth/tenant.server.ts and CLAUDE.md "Security requirements".
  shop String

  name        String
  description String?

  // Validated by BrandStylePresetAttributesSchema before being written —
  // never trusted as-is (see CLAUDE.md "Reject malformed provider
  // output", applied here to merchant input rather than provider output).
  attributes Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One name per shop — avoids two "Custom Warm Look" presets confusing
  // the picker UI.
  @@unique([shop, name])
  @@index([shop])
}

// ---------------------------------------------------------------------------
// Store visuals — the not-product-scoped half of Package 3 ("Complete AI
// Store Visuals"): a homepage hero, a collection/category banner, or a
// general store CTA image. Optionally features zero, one, or several
// products (unlike GenerationJob, whose productId is required and whose
// whole plan-building pipeline assumes exactly one owning product) — see
// docs/store-visuals.md "Why a separate model family" for the full
// evaluation of alternatives (a nullable GenerationJob.productId; a
// generic subject/asset abstraction; syncing Shopify collections first).
// This mirrors the SAME "a genuinely different kind of request gets its
// own model family, but reuses the underlying pattern/queue-factory/
// storage/review/provider conventions" call Phase 4 already made for
// ProcessingJob vs. GenerationJob — not a new pattern, the third
// application of an established one.
// ---------------------------------------------------------------------------

enum StoreVisualType {
  HOMEPAGE_HERO
  COLLECTION_BANNER
  STORE_CTA
}

// Same five-terminal-plus-in-flight shape as GenerationStatus/ProcessingStatus
// — its own enum, following this schema's established one-status-enum-per-
// domain-model precedent (see ProcessingStatus's own comment) rather than
// being the first exception to it.
enum StoreVisualStatus {
  PENDING
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

// One row per store-visual REQUEST — never overwritten, mirroring
// GenerationJob's "Generation #1, #2, #3, ..." history model exactly (see
// docs/store-visuals.md). `plan` stores a `StoreVisualPlan`
// (services/store-visuals/schema.ts) — a sibling of `GenerationPlan`
// reusing its shared building blocks (SourceImageSchema,
// BrandStyleContextSchema, IdentityAnchorsSchema), not the same schema,
// since a store visual's product references are 0..N, not exactly 1.
model StoreVisualJob {
  id String @id @default(cuid())

  // Tenant. Every query against this model must be scoped by shop — see
  // lib/auth/tenant.server.ts and CLAUDE.md "Security requirements".
  shop String

  type   StoreVisualType
  status StoreVisualStatus @default(PENDING)

  // The full structured request (services/store-visuals/schema.ts's
  // StoreVisualPlanSchema) — snapshotted at request time, exactly like
  // GenerationJob.plan.
  plan Json

  errorMessage String?
  retryCount   Int     @default(0)

  providerName  String?
  providerJobId String?

  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results  StoreVisualResult[]
  products StoreVisualJobProduct[]

  @@index([shop, type])
  @@index([shop, status])
  @@index([shop, createdAt])
}

// Optional product reference for one StoreVisualJob — a join row (not a
// scalar id array) so each reference stays independently queryable and
// cascades cleanly if the underlying product is later removed by sync,
// mirroring ImageSelectionItem's pattern. A StoreVisualJob with zero rows
// here is a fully generic store visual (no specific product featured).
model StoreVisualJobProduct {
  id String @id @default(cuid())

  storeVisualJobId String
  storeVisualJob   StoreVisualJob @relation(fields: [storeVisualJobId], references: [id], onDelete: Cascade)

  shop String

  productId String
  product   ShopifyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Merchant-chosen ordering, if the UI ever needs to display "product 1,
  // product 2, ..." — not currently rendered distinctly, but cheap to
  // capture now vs. re-deriving later.
  position Int @default(0)

  createdAt DateTime @default(now())

  @@unique([storeVisualJobId, productId])
  @@index([shop])
}

// One row per output image a StoreVisualJob produced — field-for-field
// mirror of GenerationResult (never stores image binaries; reuses the
// existing ReviewStatus enum for Approve/Reject).
model StoreVisualResult {
  id String @id @default(cuid())

  shop String

  storeVisualJobId String
  storeVisualJob   StoreVisualJob @relation(fields: [storeVisualJobId], references: [id], onDelete: Cascade)

  storageKey String
  url        String?

  width  Int?
  height Int?
  format String?

  providerName     String?
  providerResultId String?
  metadata         Json?

  reviewStatus ReviewStatus @default(PENDING)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([shop, storeVisualJobId])
}

// ---------------------------------------------------------------------------
// Shop-level settings — currently just the default brand style preset (see
// docs/lifestyle-generation.md "Brand style presets" / the preset
// management UI). One row per shop, created lazily on first write.
// `defaultBrandStylePresetId` is a plain string, not a foreign key,
// because it may reference either a built-in preset (a code-constant id
// like "minimal-studio") or a shop-owned `BrandStylePreset` row's cuid —
// the two are already resolved uniformly wherever a presetId is consumed
// (see services/generation/brand-style-preset.server.ts's
// `resolveBrandStylePreset`), so this column follows that same
// convention rather than a real relation to a row that might not exist.
// ---------------------------------------------------------------------------
model ShopSettings {
  shop String @id

  defaultBrandStylePresetId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Phase 4 — Production image processing (Basic plan foundation)
// ---------------------------------------------------------------------------

// A dedicated model family, deliberately NOT a reuse of
// GenerationJob/GenerationResult — see docs/image-processing.md
// "Processing job model" for the full reasoning. In short: a processing
// job is a DETERMINISTIC transform of one existing image (background
// removal, sharpening, an aspect-ratio crop — no prompt, no creative
// plan, no multi-image input), while a GenerationJob's `plan` is a rich,
// creative `GenerationPlan` (prompt, environment, brand style, ...) that
// doesn't apply here. Forcing both into one table/JSON-blob shape would
// make `plan`'s meaning ambiguous and `GenerationType` would have to
// awkwardly represent two different kinds of taxonomy (creative asset
// category vs. deterministic operation) at once. The *pattern* (one row
// per request, never overwritten, tenant-isolated, status lifecycle,
// results relation) is deliberately copied from GenerationJob/
// GenerationResult, proven there — this is architectural consistency,
// just not literal table reuse.

// The deterministic/transformative operations `ImageProcessingProvider`
// (services/ai/types.ts) supports. Establishing all six now (per the
// Phase 4 instructions) does not mean all six are implemented end to end
// — see docs/image-processing.md "Provider selection" for which of these
// `ProductionImageProcessingProvider` actually performs
// (REMOVE_BACKGROUND/ENHANCE/RESIZE) versus which remain interface-only
// (UPSCALE/GENERATE_SHADOW/CROP).
enum ImageOperation {
  REMOVE_BACKGROUND
  ENHANCE
  UPSCALE
  GENERATE_SHADOW
  RESIZE
  CROP
}

// Same five-terminal-plus-in-flight shape as GenerationStatus, kept as
// its OWN enum rather than reusing that one — this schema already has
// one status enum per domain model (ProductStatus, SyncStatus,
// IntelligenceStatus, GenerationStatus); ProcessingStatus follows that
// established precedent rather than being the first exception to it.
enum ProcessingStatus {
  PENDING
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

// A merchant's review decision on one ProcessingResult — see
// docs/image-processing.md "Result review UI". Approving/rejecting never
// deletes anything (see "Versioning" below); Regenerate is simply a new
// ProcessingJob, not a state on this enum.
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// One row per processing REQUEST for one source image — never
// overwritten, so a product's processing history (Process #1, #2, ...)
// is preserved exactly like GenerationJob's — see docs/image-processing.md
// "Versioning". Each job always starts from the ORIGINAL ShopifyProductMedia,
// never chained from a prior ProcessingResult (see docs/image-processing.md
// "Image cleanup" — "the processing system should treat the source image
// as authoritative"): simpler, and matches "the original must always
// remain available" without needing to reason about which version in a
// chain a later job actually started from.
model ProcessingJob {
  id String @id @default(cuid())

  // Tenant. Every query against this model must be scoped by shop — see
  // lib/auth/tenant.server.ts and CLAUDE.md "Security requirements".
  shop String

  productId String
  product   ShopifyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Exactly one source image per job (unlike GenerationJob's
  // sourceMediaIds[], which can span several images for one creative
  // asset) — a processing operation is inherently per-image.
  sourceMediaId String
  sourceMedia   ShopifyProductMedia @relation(fields: [sourceMediaId], references: [id], onDelete: Cascade)

  operation ImageOperation
  status    ProcessingStatus @default(PENDING)

  // Operation-specific, validated options (e.g. `{ aspectRatio: "4:5" }`
  // for RESIZE) — see services/processing/schema.ts's
  // ProcessingOptionsSchema. Null for operations that take none (e.g.
  // REMOVE_BACKGROUND).
  options Json?

  // Snapshot of the product's Product Intelligence identity anchors at
  // request time, when available — see docs/image-processing.md
  // "Identity preservation". Unlike GenerationJob, NOT required: a
  // deterministic transform (crop/sharpen/background removal) doesn't
  // need creative grounding to stay identity-safe the way AI generation
  // does, so processing is never blocked on the product having been
  // analyzed. Null simply means "not analyzed yet" or "Product
  // Intelligence doesn't apply here".
  identityAnchors Json?

  // Merchant-safe summary of the last failure, if any (see CLAUDE.md "Safe
  // error handling" — no stack traces/internal detail here).
  errorMessage String?
  // How many attempts BullMQ has made at this job — mirrors
  // GenerationJob.retryCount; see services/processing/job.server.ts.
  retryCount   Int     @default(0)

  providerName  String?
  providerJobId String?

  startedAt   DateTime?
  completedAt DateTime?
  // Wall-clock duration of the last processing attempt, in milliseconds —
  // usage-accounting foundation only; no billing is computed from this.
  durationMs  Int?

  // Which batch this job belongs to, if it was created as part of one
  // (see ProcessingBatch below). Null for a single-image request from
  // the product detail page.
  batchId String?
  batch   ProcessingBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results ProcessingResult[]

  @@index([shop, productId])
  @@index([shop, status])
  @@index([shop, createdAt])
  @@index([batchId])
}

// One row per output image a ProcessingJob produced. Almost always
// exactly one (a deterministic transform has one natural output, unlike
// generation's "may produce several creative variations"), but modeled
// as a relation, not a 1:1, for the same reason GenerationResult is: a
// result is independently identifiable, queryable, and reviewable
// without special-casing "the" result on the job row itself.
model ProcessingResult {
  id String @id @default(cuid())

  // Tenant — denormalized alongside processingJobId, matching
  // GenerationResult/ShopifyProductMedia's established pattern.
  shop String

  processingJobId String
  processingJob   ProcessingJob @relation(fields: [processingJobId], references: [id], onDelete: Cascade)

  // Reference into StorageProvider — never a raw binary. See CLAUDE.md
  // "Storage rules".
  storageKey String
  url        String?

  width  Int?
  height Int?
  format String?

  providerName     String?
  providerResultId String?
  metadata         Json?

  // The merchant's review decision for THIS result — see
  // docs/image-processing.md "Result review UI". Approving/rejecting is
  // an update to this row (there is nothing to preserve a "history of
  // review decisions" for); the RESULT itself is never deleted or
  // overwritten regardless of the decision — "Regenerate" always creates
  // a new ProcessingJob/ProcessingResult, never mutates this one's
  // storageKey.
  reviewStatus ReviewStatus @default(PENDING)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([shop, processingJobId])
}

// Groups the independent ProcessingJobs created by one "select products →
// choose operation → start processing" batch action (see
// docs/image-processing.md "Batch processing"). Progress (total/queued/
// processing/succeeded/failed) is deliberately NOT persisted as counters
// on this row — it's computed at read time via a groupBy over
// ProcessingJob.status scoped to this batch (see
// db/repositories/processing-batch.repository.ts), the same
// derived-not-stored approach this schema already uses for Product
// Intelligence's staleness (see ProductIntelligence's model comment) —
// avoids a second source of truth that could drift from the jobs
// themselves.
model ProcessingBatch {
  id String @id @default(cuid())

  shop String

  operation ImageOperation

  // The ImageSelection this batch was started from, if any — traceability
  // only; the batch's own jobs are the source of truth once created (see
  // services/processing/batch.server.ts).
  sourceSelectionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs ProcessingJob[]

  @@index([shop, createdAt])
}

// ---------------------------------------------------------------------------
// Production hardening pass — usage accounting + publishing foundation
// ---------------------------------------------------------------------------

// A billable operation kind — mirrors this app's four job-producing
// domains. Deliberately NOT a foreign key into any of the four job
// tables (GenerationJob/ProcessingJob/StoreVisualJob/ProductIntelligence's
// analysis run): a single ledger spanning four differently-shaped job
// tables has no clean polymorphic relation in Prisma, so `jobId` below is
// a soft reference (an id string, resolved back to its owning table by
// `operationType` at read time by the caller) — the exact same "soft
// cross-domain reference" pattern services/assets/asset-library.server.ts
// already uses to merge GenerationResult/ProcessingResult/StoreVisualResult.
enum UsageOperationType {
  PRODUCT_ANALYSIS
  IMAGE_GENERATION
  IMAGE_PROCESSING
  STORE_VISUAL_GENERATION
}

enum UsageEventStatus {
  SUCCEEDED
  FAILED
}

// One row per BILLABLE OPERATION, not per BullMQ attempt — see
// services/usage/usage-accounting.server.ts's `recordUsageEvent` and
// docs/usage.md "Idempotency semantics". A job that fails on attempt 1
// and succeeds on attempt 2 (BullMQ's automatic retry — see each domain's
// queue.server.ts) produces exactly ONE usage event for that job, because
// `idempotencyKey` (below) is keyed by the job's own id, not the attempt.
// A merchant clicking "Regenerate" creates a brand-new job id (see every
// job model's own "never overwritten" convention) and therefore a
// brand-new, separate usage event — correct, since it's a new logical
// operation. No pricing/cost is computed or stored anywhere in this
// model — see CLAUDE.md "Current phase" for why.
model UsageEvent {
  id String @id @default(cuid())

  shop String

  operationType UsageOperationType
  status        UsageEventStatus

  // The originating job's own id (GenerationJob.id / ProcessingJob.id /
  // StoreVisualJob.id / ProductIntelligence's shop+productId analysis
  // run, encoded as "{productId}" for that one operationType) — see
  // module comment above for why this is a soft reference, not a FK.
  jobId String

  // "{operationType}:{jobId}" — see model comment. The single mechanism
  // that makes recording idempotent: `recordUsageEvent` upserts on this
  // key, so calling it twice for the same job (a redelivered BullMQ
  // completion, a duplicate terminal-state transition) is a no-op the
  // second time, never a double charge.
  idempotencyKey String @unique

  providerName  String?
  // Defaulted to 1 — every operation counts as one unit today; a future
  // billing phase that prices operations differently (e.g. by output
  // count or provider cost) can start reading/writing a real value here
  // without a schema change.
  unitsConsumed Int     @default(1)
  outputCount   Int     @default(0)
  durationMs    Int?

  // Free-form, non-billing detail (e.g. which generationType/operation,
  // aspect ratio) — for the merchant-facing usage UI/future audit, never
  // parsed for pricing logic.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([shop, operationType])
  @@index([shop, createdAt])
}

// What kind of approved result a PublishingJob is publishing — mirrors
// UsageEvent's "soft cross-domain reference" pattern for the same reason
// (three differently-shaped result tables, no polymorphic Prisma
// relation).
enum PublishingSourceType {
  GENERATION_RESULT
  PROCESSING_RESULT
  STORE_VISUAL_RESULT
}

// Same five-terminal-plus-in-flight shape as every other job status enum
// in this schema (GenerationStatus/ProcessingStatus/StoreVisualStatus) —
// see ProcessingStatus's own comment for why this is its own enum rather
// than a shared one.
enum PublishingStatus {
  PENDING
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

// One row per PUBLISH REQUEST — a merchant's explicit "take this
// approved result and attach it to this product's Shopify media" intent.
// Never auto-created by Approve (see docs/publishing.md "Approval and
// publishing are separate concepts") — always a distinct, deliberate
// merchant action. Never overwritten; a re-publish attempt after a
// FAILED job creates a new row, same "history preserved, never mutated"
// convention as every other job model in this schema.
model PublishingJob {
  id String @id @default(cuid())

  shop String

  sourceType     PublishingSourceType
  // Soft reference into GenerationResult.id / ProcessingResult.id /
  // StoreVisualResult.id — see PublishingSourceType's comment.
  sourceResultId String

  targetProductId String
  targetProduct   ShopifyProduct @relation(fields: [targetProductId], references: [id], onDelete: Cascade)

  status PublishingStatus @default(PENDING)

  // Shopify's own media GID (e.g. "gid://shopify/MediaImage/...") once
  // the publish succeeds — the durable proof of what was actually
  // attached, for publish history display.
  shopifyMediaId String?

  // Merchant-safe summary of the last failure, if any — see CLAUDE.md
  // "Safe error handling". Never a raw Shopify API error body.
  errorMessage String?
  retryCount   Int     @default(0)

  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, targetProductId])
  @@index([shop, sourceType, sourceResultId])
  @@index([shop, status])
  @@index([shop, createdAt])
}

// ---------------------------------------------------------------------------
// Creative Studio — conversational AI image creation/editing. See
// services/creative-studio/ and docs/creative-studio.md.
// ---------------------------------------------------------------------------

enum CreativeSessionStatus {
  ACTIVE
  ARCHIVED
}

// What a CreativeSession started FROM. PRODUCT_IMAGE: a fresh session
// opened from a product's own Shopify-hosted media (the common case —
// "Create with AI" on the product detail page). The other three: opened
// via "Continue editing" from an existing, already-generated result —
// see CreativeSession.sourceResultId's comment for why that's a soft
// reference, not a FK, mirroring PublishingSourceType/PublishingJob's
// identical pattern.
enum CreativeSourceType {
  PRODUCT_IMAGE
  GENERATION_RESULT
  PROCESSING_RESULT
  STORE_VISUAL_RESULT
}

enum CreativeMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// One row per ongoing conversation about one product's imagery — NOT one
// row per message (see docs/creative-studio.md "Session lifecycle"):
// "Product → Creative Session → multiple instructions → multiple
// generated versions" is the whole point of this model existing
// separately from GenerationJob. A session accumulates GenerationJob
// history exactly like a product accumulates generation history today
// (every instruction creates a NEW GenerationJob/GenerationResult, never
// overwrites a prior one — see GenerationJob.creativeSessionId) while
// staying one coherent, continuable thread.
model CreativeSession {
  id String @id @default(cuid())

  // Tenant. Every query against this model must be scoped by shop — see
  // lib/auth/tenant.server.ts and CLAUDE.md "Security requirements".
  shop String

  // Optional as of the standalone workspace foundation (see
  // prisma/schema.prisma's "Standalone identity / workspace foundation"
  // section) — null for a session started from an uploaded image with no
  // Shopify product (a standalone workspace, which has no ShopifyProduct
  // rows at all), present exactly as before for every Shopify-context
  // session. onDelete stays Cascade: a session's product being deleted
  // still means the session itself no longer makes sense, same as today
  // — this column merely became optional, not less strict when present.
  productId String?
  product   ShopifyProduct? @relation(fields: [productId], references: [id], onDelete: Cascade)

  sourceType     CreativeSourceType @default(PRODUCT_IMAGE)
  // Soft reference into GenerationResult.id / ProcessingResult.id /
  // StoreVisualResult.id, meaningful only when sourceType isn't
  // PRODUCT_IMAGE — see CreativeSourceType's comment and
  // services/publishing/'s PublishingJob.sourceResultId for the
  // established "soft cross-domain reference, not a Prisma FK" pattern
  // this mirrors (Prisma has no polymorphic relation).
  sourceResultId String?

  // The specific ShopifyProductMedia this session started from, when
  // sourceType is PRODUCT_IMAGE. Null when starting from a prior result
  // instead (that result's own originating GenerationJob.plan already
  // carries its own source images).
  sourceMediaId String?
  sourceMedia   ShopifyProductMedia? @relation(fields: [sourceMediaId], references: [id], onDelete: Cascade)

  // The GenerationResult currently considered "the working image" for
  // this session (the canvas' current selection) — updated whenever a
  // new result becomes current: the first successful generation, a
  // follow-up edit's result, or the merchant explicitly picking a
  // different variation to continue from. Soft reference (same reasoning
  // as sourceResultId) — always a result of one of this session's own
  // generationJobs, an invariant services/creative-studio/session.server.ts
  // enforces, not the database.
  currentResultId String?

  status CreativeSessionStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages       CreativeMessage[]
  generationJobs GenerationJob[]

  @@index([shop, productId])
  @@index([shop, status])
  @@index([shop, createdAt])
}

// One row per conversation turn (both the merchant's own message and the
// assistant's reply) — see docs/creative-studio.md "Creative context".
// Deliberately NOT the mechanism the provider itself reads from: a
// generation request is built from a compact, derived
// `services/creative-studio/creative-context.ts` structure, never the raw
// message history (see that file's doc comment for why).
model CreativeMessage {
  id String @id @default(cuid())

  shop String

  creativeSessionId String
  creativeSession   CreativeSession @relation(fields: [creativeSessionId], references: [id], onDelete: Cascade)

  role    CreativeMessageRole
  content String

  // The structured, parsed intent this USER message resolved to (see
  // services/creative-studio/intent-schema.ts's ParsedIntentSchema) —
  // null for ASSISTANT/SYSTEM messages and for a USER message that
  // failed to parse. Never a raw provider prompt — see
  // docs/creative-studio.md "No arbitrary prompts".
  intent Json?

  // Soft reference to the GenerationJob this message triggered (a USER
  // message that requested generation) or reports on (an ASSISTANT
  // message once the job resolves) — null for a plain conversational
  // message that didn't (yet) result in a job.
  generationJobId String?

  createdAt DateTime @default(now())

  @@index([shop, creativeSessionId, createdAt])
}

enum CreditReservationStatus {
  RESERVED
  CONSUMED
  REFUNDED
}

// The Creative Studio credit entitlement ledger's reserve/settle/refund
// lifecycle — see services/usage/entitlement.server.ts and
// docs/creative-studio.md "Credit lifecycle". Deliberately separate from
// UsageEvent (services/usage/usage-accounting.server.ts): UsageEvent is a
// record-after-the-fact AUDIT ledger of completed operations (upsert on
// idempotencyKey, only ever SUCCEEDED/FAILED); this is a live credit-HOLD
// table with a genuine third, pre-resolution state (RESERVED) a request
// must pass through before a job is even created — a different kind of
// table for a different kind of question ("can this proceed, and is a
// hold on it currently outstanding?" vs. "what happened, for the
// record?"), the same "genuinely different kind of request gets its own
// model" call this schema has made repeatedly (Processing vs. Generation,
// StoreVisuals vs. Generation).
model CreditReservation {
  id String @id @default(cuid())

  shop String

  // The GenerationJob this reservation is for. @unique makes
  // reserveGenerationCredits naturally idempotent: a retried/duplicate
  // reservation attempt for the same job finds the existing row instead
  // of creating a second hold — see docs/creative-studio.md "Credit
  // lifecycle".
  jobId String @unique

  // Which billable capability this hold is for — see
  // services/usage/credit-costs.ts's `getCreditCost`. Reuses the exact
  // same enum UsageEvent already uses (no parallel taxonomy).
  operationType UsageOperationType

  amount Int                     @default(1)
  status CreditReservationStatus @default(RESERVED)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([shop, status])
  @@index([shop, createdAt])
  @@index([shop, operationType])
}

// ---------------------------------------------------------------------------
// Billing / subscriptions — see services/billing/ and docs/billing.md.
// ---------------------------------------------------------------------------

// Plan DEFINITIONS (monthly credits, resolution/output limits, feature
// gates) are code constants (services/billing/plans.ts), not rows — the
// same "a small, versioned-in-code catalog, not merchant-editable data"
// call this schema already made for the 6 built-in brand style presets
// (services/generation/brand-style-presets.ts) and category
// recommendations. This enum is just the stable identifier a
// ShopSubscription points at.
enum PlanId {
  FREE
  STARTER
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  // Shopify's own AppSubscription.status vocabulary
  // (https://shopify.dev/docs/api/admin-graphql/latest/enums/AppSubscriptionStatus),
  // reused directly rather than inventing a parallel one — see
  // services/billing/shopify-billing-provider.server.ts.
  PENDING
  ACTIVE
  CANCELLED
  DECLINED
  EXPIRED
  FROZEN
}

// One row per shop — the shop's current plan/subscription state. Absence
// of a row means FREE (services/billing/plans.ts's default) — no need to
// backfill every shop with an explicit FREE row the moment it installs.
model ShopSubscription {
  id String @id @default(cuid())

  shop String @unique

  planId PlanId             @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  // Shopify's own AppSubscription GID
  // ("gid://shopify/AppSubscription/...") — null until a real
  // subscription is created via the Shopify Billing API (see
  // docs/billing.md "Provider decision" for why Shopify Billing, not a
  // third-party processor, is the correct mechanism for a Shopify
  // embedded app).
  shopifySubscriptionId String?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([shopifySubscriptionId])
}

enum BillingEventType {
  SUBSCRIPTION_REQUESTED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_CANCELLED
  SUBSCRIPTION_DECLINED
  SUBSCRIPTION_EXPIRED
  PLAN_CHANGED
  WEBHOOK_RECEIVED
}

// Idempotent audit trail for every billing-related event — both
// merchant-initiated actions (requesting/cancelling a subscription) and
// Shopify webhook deliveries (`app_subscriptions/update`). See
// docs/billing.md "Idempotency" — `idempotencyKey` is what makes a
// redelivered webhook (or a merchant double-clicking "Upgrade") a safe
// no-op rather than a duplicate plan change.
model BillingEvent {
  id String @id @default(cuid())

  shop String

  type                  BillingEventType
  shopifySubscriptionId String?
  fromPlanId            PlanId?
  toPlanId              PlanId?

  // "{type}:{shopifySubscriptionId or shop}:{a stable discriminator}" —
  // see services/billing/subscription.server.ts for the exact
  // construction per event type.
  idempotencyKey String @unique

  // Free-form, non-secret detail (e.g. the webhook's own reported
  // status) — never raw request headers, signatures, or credentials.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([shop, createdAt])
  @@index([shop, type])
}

// --- Standalone identity / workspace foundation ---------------------------
//
// Added for the standalone (non-Shopify) product experience — see
// docs/roadmap.md "Two experiences, one core". Deliberately additive only:
// every existing model above is untouched, and every existing repository/
// service function keeps working unmodified, because of one design choice —
// `Workspace.tenantKey` is written into the exact same `shop: String` column
// every existing shop-scoped model already uses as an opaque tenant key
// (nothing in this codebase validates that string is a real
// `*.myshopify.com` domain). A standalone user's `AuthContext.shop` resolves
// to their workspace's `tenantKey`; a Shopify merchant's `AuthContext.shop`
// continues to be their real shop domain, exactly as before. Both flow
// through the identical downstream pipeline.
//
// Conversations/generations/credits need no new ownership tables — they're
// already owned by `shop`, which now just has two different real-world
// meanings depending on which auth path produced it.

model User {
  id           String @id @default(cuid())
  email        String @unique
  // Node's built-in `crypto.scrypt` output — see lib/auth/password.server.ts.
  // Never a plaintext password, never a third-party-library-specific format
  // that would lock this to one hashing library.
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships WorkspaceMembership[]
  sessions    UserSession[]

  creativePreferences CreativePreferenceObservation[]
}

// The persistent backing for services/creative-studio/personalization.server.ts's
// `CreativeProfileStore` (Layer 2 of the Creative Studio's creative
// -intelligence model) — replaces that module's original in-memory-only
// implementation, which could not survive across Vercel (web) and
// Railway (worker) being separate processes/hosts. One row per
// (userId, field, value) triple ever observed — e.g. (user-1, "lighting",
// "cinematic") — NOT one row per raw prompt/message: this table stores
// STRUCTURED, aggregated preference signal, never a transcript.
//
// `positiveWeight`/`negativeWeight` are running weighted sums (see
// personalization.server.ts's `SIGNAL_WEIGHT` — explicit feedback carries
// more weight per observation than an inferred same-session correction);
// confidence is computed at READ time as
// `positiveWeight / (positiveWeight + negativeWeight)`, decayed by
// `lastObservedAt`'s age — never persisted as its own column, since it's
// a pure function of the other fields and "now," and persisting a
// time-dependent derived value would make it silently stale.
//
// Scoped to `userId`, not `shop`/workspace — see personalization.server.ts's
// module doc comment for why: a Workspace can have multiple standalone
// Users, and Shopify has no User concept at all (a Shopify-context
// generation never touches this table). `onDelete: Cascade` — a deleted
// user's learned preferences are deleted with them, matching this
// codebase's `shop/redact` GDPR-deletion discipline for every other
// personal data table.
model CreativePreferenceObservation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One of services/creative-studio/personalization.server.ts's
  // `LEARNABLE_FIELDS` ("style"/"lighting"/"composition"/"camera"/
  // "colorDirection") — a plain string, not a Prisma enum, so a future
  // additional learnable field needs no migration (mirrors how
  // `UsageEvent`/other append-only tables in this schema already treat
  // their own "kind" discriminator as a validated string, not a DB enum).
  field String
  // The specific value observed for that field — e.g. "cinematic",
  // "premium". Free text, same reasoning as `field`.
  value String

  // Which coarse creative CONTEXT this observation was made in — one of
  // services/creative-studio/personalization.server.ts's
  // `PreferenceContext` ("campaign" | "catalog" | "general"), derived
  // from the request's own `intent`. A plain string, not a Prisma enum,
  // for the same "no migration for a future addition" reason as `field`.
  //
  // This exists to satisfy a real, explicitly-requested requirement: a
  // merchant's preference is not always ONE global taste — someone may
  // genuinely want dark, cinematic imagery for a campaign/lifestyle shot
  // and bright, clean imagery for a plain catalog listing. Without this
  // column, both observations would land on the same (userId, field,
  // value) row and the system would incorrectly report "this user
  // prefers dark lighting" everywhere, including catalog images they
  // never asked to be dark. Each context is a fully separate bucket of
  // observations — there is deliberately no cross-context fallback (see
  // `getProfile`'s doc comment) so an unrelated context can never
  // contaminate another.
  context String @default("general")

  positiveWeight Float    @default(0)
  negativeWeight Float    @default(0)
  sampleCount    Int      @default(0)
  lastObservedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per (user, field, value, context) — an observation of an
  // already-seen (value, context) pair updates this row rather than
  // inserting a new one.
  @@unique([userId, field, value, context])
  @@index([userId])
}

// A random, unguessable, single-use login token — only its hash is ever
// persisted (see lib/auth/standalone-session.server.ts), mirroring this
// codebase's existing "never store the raw secret" convention (media
// signing, credit reservation idempotency keys, ...).
model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Workspace {
  id   String @id @default(cuid())
  name String

  // The tenant key written into AuthContext.shop for every standalone
  // request scoped to this workspace — see this section's own doc comment.
  // A generated opaque id, never a real Shopify domain.
  tenantKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       WorkspaceMembership[]
  shopifyConnection WorkspaceShopifyConnection?
}

// Join table between User and Workspace. `role` exists so "who belongs to
// this workspace" is answerable later without a migration, but nothing in
// this phase checks it beyond the default — no RBAC yet, deliberately (see
// docs/roadmap.md's Phase 1 scoping). Every user gets exactly one workspace
// (their default) created at signup; this table is what makes "more than
// one" representable later without another migration.
model WorkspaceMembership {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        String    @default("owner")
  createdAt   DateTime  @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// The seam for "Shopify becomes an integration belonging to a workspace"
// (see docs/roadmap.md) — declared now, populated by nothing yet. Linking
// an existing Shopify install to a standalone workspace is explicitly
// future work, not this phase.
model WorkspaceShopifyConnection {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  shopDomain  String    @unique
  connectedAt DateTime  @default(now())
}
